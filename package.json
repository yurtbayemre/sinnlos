{
  "name": "sinnlos-intranet",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted intranet platform: Strapi v5 + Next.js 16 + Microsoft Entra ID login",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tests",
    "typecheck:tests": "pnpm --filter @sinnlos/web exec tsc -p ../../tsconfig.test.json && pnpm --filter @sinnlos/cms exec tsc -p ../../tsconfig.test.cms.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cms:dev": "pnpm --filter @sinnlos/cms dev",
    "web:dev": "pnpm --filter @sinnlos/web dev"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils@>=3.0.0 <3.0.28": ">=3.0.28 <3.0.31",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "@hono/node-server@>=1.0.0 <1.19.15": "^1.19.15",
      "@humanfs/node@>=0.16.0 <0.16.8": "^0.16.8",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "brace-expansion@>=1.0.0 <1.1.18": "^1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "dompurify@>=3.0.0 <3.4.13": "^3.4.13",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "form-data@<4.0.6": ">=4.0.6",
      "hono@>=4.0.0 <4.13.5": "^4.13.5",
      "ip-address@>=10.0.0 <10.3.1": "^10.3.1",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "linkify-it@>=5.0.0 <5.0.2": "^5.0.2",
      "lodash@>=4.0.0 <4.18.0": "^4.18.0",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "nodemailer@>=9.0.0 <9.1.1": "^9.1.1",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "^6.1.3",
      "postcss-selector-parser@>=7.1.0 <7.1.3": "^7.1.3",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "shell-quote@>=1.0.0 <1.9.0": "^1.9.0",
      "tar@>=7.0.0 <7.5.21": "^7.5.21",
      "tmp@<0.2.6": ">=0.2.6",
      "undici@>=6.0.0 <6.28.1": "^6.28.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    }
  }
}
