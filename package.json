{
  "name": "sinnlos-intranet",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted intranet platform: Strapi v5 + Next.js 16, local sign-in with optional Microsoft Entra ID",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm build:domain && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:domain": "pnpm --filter @sinnlos/domain build",
    "start": "pnpm -r --parallel start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:domain && pnpm -r typecheck && pnpm typecheck:tests",
    "typecheck:tests": "pnpm --filter @sinnlos/web exec tsc -p ../../tsconfig.test.json && pnpm --filter @sinnlos/cms exec tsc -p ../../tsconfig.test.cms.json",
    "test": "vitest run && pnpm --filter @sinnlos/e2e test:runner",
    "test:tz": "node scripts/test-tz.mjs",
    "test:integration": "pnpm build:domain && vitest run --config vitest.integration.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cms:dev": "pnpm --filter @sinnlos/cms dev",
    "web:dev": "pnpm --filter @sinnlos/web dev",
    "test:e2e": "pnpm --filter @sinnlos/e2e test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "dompurify@>=3.0.0 <3.4.16": "^3.4.16",
      "esbuild@>=0.27.0 <0.28.1": "^0.28.1",
      "handlebars@>=4.0.0 <4.7.10": "^4.7.10",
      "markdown-it@>=14.0.0 <14.3.1": "^14.3.1",
      "nodemailer@>=5.0.0 <10.0.9": "^10.0.9",
      "postcss-selector-parser@>=6.0.0 <7.1.6": "^7.1.6",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "sharp@>=0.35.0 <0.35.5": "^0.35.5",
      "webpack-dev-middleware@>=6.0.0 <7.4.6": "^7.4.6",
      "next>@playwright/test": "-"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "core-js-pure",
      "unrs-resolver"
    ]
  }
}
