# Strapi backend (server-side only)
STRAPI_URL=http://localhost:1337
STRAPI_PUBLIC_URL=http://localhost:1337

# Shared secret for the internal Strapi -> Next.js live-event ingest
# (POST /api/live/emit, header x-revalidate-secret). The name is historical:
# the cache-revalidation webhook it once also guarded is gone (Strapi reads
# are never cached, D-DC01). Must match REVALIDATE_SECRET in apps/cms/.env.
# Unset: /api/live/emit answers 503, so no live-event pings arrive.
# openssl rand -hex 32
REVALIDATE_SECRET=

# Shared secret the /uploads proxy route presents to the cms. Must match
# INTERNAL_UPLOAD_TOKEN in apps/cms/.env; optional in development, required
# in production (the cms answers 404 for every file without it).
# openssl rand -hex 32
INTERNAL_UPLOAD_TOKEN=

# Live updates (SSE): 1 = kill switch, /live/stream answers 404 and the
# app polls. Keep the same value as the cms.
LIVE_EVENTS_DISABLED=0

# Optional: Meilisearch search ranking, off unless MEILISEARCH_ENABLED=1
# (same as the cms). Server side only, with the search-only key; on any
# Meilisearch error the built-in search answers. Keys and runbook:
# infra/.env.example and docs/DEPLOYMENT.md, "Meilisearch (optional search)".
# MEILISEARCH_ENABLED=1
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_SEARCH_KEY=

# Default UI language for users who haven't picked one. Supported: en, de
# (unset or invalid = en).
DEFAULT_LOCALE=en

# Demo mode (local UI work only): set to 1 to bypass auth + Strapi and
# render the in-memory fixture dataset (apps/web/src/lib/demo/).
# Never set in production.
DEMO_MODE=

# Auth.js (NextAuth v5)
# AUTH_URL's scheme also names the session cookie (https →
# __Secure-authjs.session-token); the server-side Strapi token reader
# (src/lib/strapi-token.ts) derives the name the same way.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Local email+password sign-in (against Strapi) is on whenever neither
# ENTRA_ENABLED nor OIDC_ENABLED is 1. Set AUTH_LOCAL_ENABLED=1 to ALSO offer
# it next to the identity provider. Accounts come from invitations at
# /manage/users (v0.27; there is no self-registration).
AUTH_LOCAL_ENABLED=

# Optional: Microsoft Entra ID sign-in (D-ENTRA-01), off by default.
# Nothing below is read unless ENTRA_ENABLED=1; then every value is
# validated at start and an invalid one fails every request. Tenant setup:
# infra/.env.example and docs/DEPLOYMENT.md, "Microsoft Entra ID sign-in"
# (redirect URI ${AUTH_URL}/api/auth/callback/microsoft-entra-id). The
# issuer is computed from the tenant GUID.
# ENTRA_ENABLED=1
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=<directory-tenant-guid>
# AUTH_MICROSOFT_ENTRA_ID_ID=<application-client-guid>
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Same value as ENTRA_EXCHANGE_SECRET in apps/cms/.env (32+ characters)
# ENTRA_EXCHANGE_SECRET=
# 1 = also request User.Read.All (the cms syncs the manager); same as the cms.
# ENTRA_SYNC_MANAGER=0

# Optional: OIDC sign-in with Keycloak, authentik or Zitadel (v0.25.0), off
# by default and never together with ENTRA_ENABLED=1. Nothing below is read
# unless OIDC_ENABLED=1; then every value is validated at start. Setup:
# infra/.env.example and docs/DEPLOYMENT.md, "OIDC sign-in (Keycloak,
# authentik, Zitadel)" (redirect URI ${AUTH_URL}/api/auth/callback/oidc).
# OIDC_ENABLED=1
# Exactly as the identity provider's discovery document writes it.
# OIDC_ISSUER=https://sso.example.com/realms/sinnlos
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Same value as OIDC_EXCHANGE_SECRET in apps/cms/.env (32+ characters)
# OIDC_EXCHANGE_SECRET=
# OIDC_SCOPE=openid profile email
# OIDC_DISPLAY_NAME=Single Sign-On
# Zitadel only: adds the organisation scopes (same value as the cms).
# OIDC_ZITADEL_ORG_ID=
# 1 = allow an http issuer (local development only)
# OIDC_ALLOW_HTTP=0
