# Strapi server
#
# Secrets: generate each with `openssl rand -base64 32` (APP_KEYS takes two,
# comma-separated). The toBeModified placeholders only produce a warning in
# development; with NODE_ENV=production the cms refuses to start while any
# of them (or REVALIDATE_SECRET / INTERNAL_UPLOAD_TOKEN) is still a template
# placeholder (change-me…, toBeModified…, <secret>).
HOST=0.0.0.0
PORT=1337
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
JWT_SECRET=toBeModified
ENCRYPTION_KEY=toBeModified

# Initial Strapi Super Admin
#
# On first boot (when the admin_users table is empty), bootstrap()
# creates a Strapi admin user from these env vars so you don't have
# to click through the registration form after wiping the database.
# Leave them blank to keep the classic interactive flow. The seed refuses
# template placeholders (change-me…, @example.com) and passwords failing
# the admin policy (8+ chars with upper, lower and a digit) — it then logs
# an error and creates no admin.
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=
STRAPI_ADMIN_FIRSTNAME=Admin
STRAPI_ADMIN_LASTNAME=User

# Database
#
# Local quick start (default): SQLite file — no server required.
# For production / Docker Compose: set DATABASE_CLIENT=postgres and
# uncomment the Postgres block below. The hostname `db` resolves inside
# the Docker Compose network; use `localhost` for a Postgres server
# running directly on your machine.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# DATABASE_CLIENT=postgres
# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=sinnlos
# DATABASE_USERNAME=sinnlos
# DATABASE_PASSWORD=sinnlos
# DATABASE_SSL=false
# With Postgres the cms must run in UTC whenever it creates or changes the
# schema (datetime contract); uncomment on a machine in another zone:
# TZ=UTC
# DATABASE_URL must not carry its own `options` parameter (the cms pins
# every session to TimeZone=UTC through it).

# Business time zone (IANA name): "today", day/week windows, birthdays,
# cron times, all-day events, poll deadlines. Unset = Europe/Berlin.
# APP_TIME_ZONE=Europe/Berlin

# Public URL used for OAuth redirect construction
PUBLIC_URL=http://localhost:1337

# Microsoft Entra ID (Azure AD)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# Standalone mode (no Microsoft / Azure)
#
# Local email+password auth works out of the box — leave the MS_* vars
# above empty and the Microsoft provider stays disabled.
# Set LOCAL_REGISTRATION=1 to let users self-register from the sign-in
# page; leave it unset to create accounts in the Strapi admin instead.
LOCAL_REGISTRATION=

# CORS — comma-separated origins allowed to call the Strapi API.
# Defaults to http://localhost:3000 when unset. Set to the Next.js
# public URL in production (Docker Compose passes WEB_PUBLIC_URL).
CORS_ORIGIN=http://localhost:3000

# Live-event pings → Next.js (POST /api/live/emit)
#
# REVALIDATE_SECRET must match the value in apps/web/.env.local; it
# authenticates the live-event ingest (header x-revalidate-secret — the
# name is historical, the web no longer caches Strapi responses, D-DC01).
# WEB_INTERNAL_URL is how the CMS reaches Next.js for those pings only
# (e.g. http://localhost:3000 locally, http://web:3000 in Docker Compose).
# Leave either unset to send no live-event pings. openssl rand -hex 32
REVALIDATE_SECRET=
WEB_INTERNAL_URL=http://localhost:3000

# Shared secret for the uploaded-file bytes: the web's session-gated
# /uploads proxy presents it to the cms. Optional in development (the gate
# is a no-op while unset); REQUIRED in production, where every /uploads
# request answers 404 without it. Same value in apps/web/.env.local.
# openssl rand -hex 32
INTERNAL_UPLOAD_TOKEN=

# Live updates (SSE): 1 = kill switch, the cms stops emitting pings. Keep
# the same value as the web app.
LIVE_EVENTS_DISABLED=0

# E-mail digests (optional; the cron is a logged no-op without SMTP).
# Use a mailbox app password (SMTP-only). With SMTP set, DIGEST_FROM and
# PUBLIC_WEB_URL (the link base) are required — the run is skipped with a
# warning otherwise. DIGESTS_DISABLED=1 is the kill switch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. Intranet <noreply@intranet.example.com>
DIGEST_FROM=
DIGEST_REPLY_TO=
DIGESTS_DISABLED=0
PUBLIC_WEB_URL=http://localhost:3000

# SEED_DEMO_DATA=1 populates departments, teams, users, announcements,
# events, wiki pages, kudos, polls and documents on first boot
# (apps/cms/src/seed-demo.ts). All demo users share the password
# "demo1234". Leave unset/0 for a clean database.
SEED_DEMO_DATA=
