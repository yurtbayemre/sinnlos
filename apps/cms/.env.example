# Strapi server
#
# Secrets: generate each with `openssl rand -base64 32` (APP_KEYS takes two,
# comma-separated). The toBeModified placeholders only produce a warning in
# development; with NODE_ENV=production the cms refuses to start while any
# of them (or REVALIDATE_SECRET / INTERNAL_UPLOAD_TOKEN) is still a template
# placeholder (change-me…, toBeModified…, <secret>).
HOST=0.0.0.0
PORT=1337
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
JWT_SECRET=toBeModified
ENCRYPTION_KEY=toBeModified

# Initial Strapi Super Admin
#
# On first boot (when the admin_users table is empty), bootstrap()
# creates a Strapi admin user from these env vars so you don't have
# to click through the registration form after wiping the database.
# Leave them blank to keep the classic interactive flow. The seed refuses
# template placeholders (change-me…, @example.com) and passwords failing
# the admin policy (8+ chars with upper, lower and a digit) — it then logs
# an error and creates no admin.
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=
STRAPI_ADMIN_FIRSTNAME=Admin
STRAPI_ADMIN_LASTNAME=User

# Admin panel feature flags (config/admin.ts), off unless `true`: the
# in-admin NPS survey and the Enterprise Edition promotion.
# FLAG_NPS=false
# FLAG_PROMOTE_EE=false

# No usage telemetry to Strapi (Docker Compose sets it too). Strapi accepts
# true or 1.
STRAPI_TELEMETRY_DISABLED=true

# Database (config/database.ts)
#
# Local quick start (default): SQLite file, no server required.
# DATABASE_FILENAME is relative to apps/cms; an absolute path is used as is.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres: set DATABASE_CLIENT=postgres and uncomment what you need. Docker
# Compose sets these itself (host sinnlos-db); use `localhost` for a
# Postgres server running directly on your machine.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=sinnlos
# DATABASE_USERNAME=sinnlos
# DATABASE_PASSWORD=sinnlos
# DATABASE_SCHEMA=public
# Or one connection URL; its values win over the keys above. It must not
# carry its own `options` query parameter: the cms pins every session to
# TimeZone=UTC through it and refuses to start with other options (unless
# they set -c TimeZone=UTC themselves).
# DATABASE_URL=postgres://sinnlos:sinnlos@localhost:5432/sinnlos
# Connection pool: at least / at most this many connections, and how long
# (ms) a query waits for a free one before it fails.
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000
# TLS to Postgres (off by default; only the exact value `true` switches it
# on). KEY, CERT and CA take the PEM text itself, not a file path;
# REJECT_UNAUTHORIZED=false accepts any server certificate (avoid).
# DATABASE_SSL=false
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Read as well, but MySQL options that the Postgres driver ignores:
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=
# Destructive schema sync, off by default: true lets the next boot DROP the
# columns, tables and indexes that removed attributes left behind. Only for
# a deliberate one-off cleanup after a backup (docs/architecture.md §5.27).
# DATABASE_FORCE_MIGRATION=false

# Datetime contract (docs/DEPLOYMENT.md §3.10). With Postgres the cms must
# run in UTC whenever it creates or changes the schema; uncomment on a
# machine in another zone:
# TZ=UTC
# Only for a database written by a cms before the datetime contract (a
# fresh database leaves both empty): the zone that cms ran in, and the
# switch instant if it ran in UTC first. See infra/.env.example.
# DATETIME_LEGACY_ZONE=Europe/Berlin
# DATETIME_LEGACY_UTC_UNTIL=

# Business time zone (IANA name, no UTC offset): "today", day/week windows,
# birthdays, cron times, all-day events, poll deadlines. Unset = Europe/Berlin.
# APP_TIME_ZONE=Europe/Berlin

# Public URL of the cms (upload URLs, admin panel)
PUBLIC_URL=http://localhost:1337

# Local email+password auth works out of the box (Microsoft sign-in is
# off unless ENTRA_ENABLED=1 below).
# Set LOCAL_REGISTRATION=1 to let users self-register from the sign-in
# page; leave it unset to create accounts in the Strapi admin instead.
LOCAL_REGISTRATION=

# Optional: Microsoft Entra ID sign-in (D-ENTRA-01), off by default.
# Nothing below is read unless ENTRA_ENABLED=1; then every value is
# validated at boot and an invalid one refuses the start. Tenant setup and
# the meaning of each value: infra/.env.example and docs/DEPLOYMENT.md,
# "Microsoft Entra ID sign-in". The cms needs no client secret: it verifies
# the ID token against the tenant's keys itself.
# ENTRA_ENABLED=1
# MS_TENANT_ID=<directory-tenant-guid>
# MS_CLIENT_ID=<application-client-guid>
# Same value as in apps/web/.env.local, 32+ characters (openssl rand -hex 32)
# ENTRA_EXCHANGE_SECRET=
# ENTRA_SYNC_MODE=dry-run
# ENTRA_DEFAULT_ROLE=member
# ENTRA_GROUP_ROLES=
# ENTRA_SYNC_DEPARTMENT=0
# ENTRA_SYNC_MANAGER=0
# ENTRA_SESSION_TTL=12h
# With Entra on, local sign-in stays available only with AUTH_LOCAL_ENABLED=1.
# AUTH_LOCAL_ENABLED=0

# CORS — comma-separated origins allowed to call the Strapi API.
# Defaults to http://localhost:3000 when unset. Set to the Next.js
# public URL in production (Docker Compose passes WEB_PUBLIC_URL).
CORS_ORIGIN=http://localhost:3000

# Live-event pings → Next.js (POST /api/live/emit)
#
# REVALIDATE_SECRET must match the value in apps/web/.env.local; it
# authenticates the live-event ingest (header x-revalidate-secret — the
# name is historical, the web no longer caches Strapi responses, D-DC01).
# WEB_INTERNAL_URL is how the CMS reaches Next.js for those pings only
# (e.g. http://localhost:3000 locally; Docker Compose sets
# http://sinnlos-web:3000).
# Leave either unset to send no live-event pings. openssl rand -hex 32
REVALIDATE_SECRET=
WEB_INTERNAL_URL=http://localhost:3000

# Shared secret for the uploaded-file bytes: the web's session-gated
# /uploads proxy presents it to the cms. Optional in development (the gate
# is a no-op while unset); REQUIRED in production, where every /uploads
# request answers 404 without it. Same value in apps/web/.env.local.
# openssl rand -hex 32
INTERNAL_UPLOAD_TOKEN=

# Live updates (SSE): 1 = kill switch, the cms stops emitting pings. Keep
# the same value as the web app.
LIVE_EVENTS_DISABLED=0

# E-mail digests (optional; the cron is a logged no-op without SMTP).
# Use a mailbox app password (SMTP-only). With SMTP set, DIGEST_FROM and
# PUBLIC_WEB_URL (the link base) are required — the run is skipped with a
# warning otherwise. DIGESTS_DISABLED=1 is the kill switch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. Intranet <noreply@intranet.example.com>
DIGEST_FROM=
DIGEST_REPLY_TO=
DIGESTS_DISABLED=0
PUBLIC_WEB_URL=http://localhost:3000
# Digest language of a user whose profile has none: en or de (unset or
# invalid = en). The web's language switch stores the profile language.
DIGEST_DEFAULT_LOCALE=en

# Scheduled jobs (03:30 uploads janitor, 03:35 search-log janitor, 07:30
# digest mailer, in APP_TIME_ZONE). Unset or true (the default) runs them;
# false (also 0/no/off) switches these three off in this process (Strapi's
# own metrics jobs run on). Read like the cms's other on/off switches
# (src/cron/registry.ts).
CRON_ENABLED=true

# SEED_DEMO_DATA=1 populates departments, teams, users, announcements,
# events, wiki pages, kudos, polls and documents on first boot
# (apps/cms/src/seed-demo.ts). All demo users share the password
# "demo1234". Leave unset/0 for a clean database.
SEED_DEMO_DATA=
