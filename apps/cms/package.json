{
  "name": "@sinnlos/cms",
  "private": true,
  "version": "0.1.0",
  "description": "Strapi v5 backend for the Sinnlos intranet",
  "scripts": {
    "dev": "strapi develop",
    "start": "strapi start",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && strapi build",
    "strapi": "strapi",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sinnlos/domain": "workspace:*",
    "@strapi/plugin-users-permissions": "5.58.0",
    "@strapi/provider-email-nodemailer": "5.58.0",
    "@strapi/strapi": "5.58.0",
    "@strapi/utils": "5.58.0",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "styled-components": "6.6.0",
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@strapi/typescript-utils": "5.58.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "sinnlos-intranet"
  }
