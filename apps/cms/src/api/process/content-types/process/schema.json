    "diagram": { "type": "text" },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "ownerDepartment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department"
    }
  }
}
