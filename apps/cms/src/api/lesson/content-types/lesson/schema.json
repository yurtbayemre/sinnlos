{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "One lesson of a training course: markdown body, validated YouTube video and a private quiz answer key. Learners use the answerless player and server feedback/completion actions; authors edit the quiz in the panel."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "lessons"
    },
    "videoUrl": {
      "type": "string"
    },
    "quiz": {
      "type": "json",
      "private": true
    },
    "publishAt": {
      "type": "datetime"
    },
    "scheduleError": {
      "type": "string"
    }
  }
}
