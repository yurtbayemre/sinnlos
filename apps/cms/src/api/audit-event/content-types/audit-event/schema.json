{
  "kind": "collectionType",
  "collectionName": "audit_events",
  "info": {
    "singularName": "audit-event",
    "pluralName": "audit-events",
    "displayName": "Audit event",
    "description": "Content activity trail (decision 06 §H): one row per Document Service change of a guarded document, written inside the change's transaction by utils/audit.ts. Append-only (lifecycles.ts); kept AUDIT_RETENTION_DAYS (default 365). Keys only, never values. Admin-only fixed activity read; no content-API writes."
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "action": {
      "type": "enumeration",
      "enum": [
        "create",
        "update",
        "delete",
        "clone",
        "publish",
        "unpublish",
        "discardDraft",
        "restore",
        "schedulePublish",
        "scheduleUnpublish",
        "scheduleFailed"
      ],
      "required": true
    },
    "targetUid": { "type": "string", "required": true },
    "targetDocumentId": { "type": "string", "required": true },
    "revision": { "type": "integer" },
    "actorKind": {
      "type": "enumeration",
      "enum": ["user", "admin", "system"],
      "required": true
    },
    "actorUserId": { "type": "integer" },
    "actorAdminId": { "type": "integer" },
    "actorClass": { "type": "string" },
    "source": {
      "type": "enumeration",
      "enum": ["content-api", "admin", "cron", "system"],
      "required": true
    },
    "keys": { "type": "json" },
    "detail": { "type": "string" }
  }
}
