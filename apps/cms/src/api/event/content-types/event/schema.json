{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Company events, town halls, and meetings"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "description": { "type": "richtext" },
    "start": { "type": "datetime", "required": true },
    "end": { "type": "datetime" },
    "allDay": { "type": "boolean", "default": false },
    "rsvpEnabled": { "type": "boolean", "default": false },
    "capacity": { "type": "integer", "min": 1 },
    "location": { "type": "string" },
    "url": { "type": "string" },
    "departments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::department.department"
    },
    "organizer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "notifyAudience": {
      "type": "enumeration",
      "enum": ["all", "departments"],
      "default": "all"
    },
    "ownerDepartment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department"
    },
    "publishAt": { "type": "datetime" },
    "scheduleError": { "type": "string" }
  }
}
