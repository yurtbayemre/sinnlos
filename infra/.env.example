# ----------------------------------------------------------------------
# Public URLs (use https://... in production)
#
# DOMAIN is the public host name of this instance.
# Bundled Caddy (docker-compose.yml alone) uses it as its site address:
#   - real hostname           -> automatic Let's Encrypt certificate, HSTS
#   - unset (localhost)       -> certificate from Caddy's internal CA,
#                                browser warning unless its root is
#                                trusted (docs/DEPLOYMENT.md, Common Issues)
#   - http://localhost        -> plain HTTP (local development only)
# Host Traefik (with docker-compose.traefik.yml) REQUIRES it, as the bare
# host name (no scheme, no port): every router matches Host(`$DOMAIN`), and
# compose refuses to render the overlay without it. Keep it equal to the
# host of WEB_PUBLIC_URL and CMS_PUBLIC_URL: infra/deploy.sh refuses a
# DOMAIN that is not a bare host name, is a placeholder such as the value
# below, or is not the host of both URLs.
# One Sinnlos stack per Traefik: the router, service and middleware names
# are fixed (sinnlos-*), so a second instance (employer, staging) needs its
# own host or Traefik. Behind the production Traefik it would delete
# production's routers (different DOMAIN) or share its services (same
# DOMAIN).
# ----------------------------------------------------------------------
DOMAIN=intranet.example.com
WEB_PUBLIC_URL=https://intranet.example.com
CMS_PUBLIC_URL=https://intranet.example.com

# Client IPs (FX11): the cms trusts X-Forwarded-For, so its sign-in
# throttles count per client IP — users-permissions /api/auth/local and
# the admin panel's /admin/login (5 attempts per 5 minutes per e-mail and
# IP). That is only sound while the edge OVERWRITES a client-supplied
# X-Forwarded-For. Caddy does so by default. A host Traefik
# (docker-compose.traefik.yml) does so only while its entrypoint sets no
# forwardedHeaders.insecure and lists in forwardedHeaders.trustedIPs only
# proxies that overwrite (not append to) the header — otherwise anyone
# picks their own throttle bucket and /admin/login is unthrottled.

# The Strapi admin panel and its APIs (/admin, /content-manager, /upload,
# /users-permissions, /i18n, /email, …) answer only clients from these
# networks, by the same client IP: a comma list of IPv4/IPv6 CIDRs, e.g.
# 203.0.113.0/24,2001:db8::/48 for an office or VPN. Empty means loopback
# only: closed from outside; infra/admin-tunnel.sh then opens it through an
# SSH tunnel (docs/INSTALL.md). 0.0.0.0/0,::/0 opens it to everyone (the cms
# logs a warning). Set it before you first open /admin.
ADMIN_ALLOW_CIDRS=

# The release and commit an image is built from (its version and revision
# labels); infra/deploy.sh sets both for every build. Not settings.
# SINNLOS_VERSION=
# SINNLOS_REVISION=

# ----------------------------------------------------------------------
# Optional: footer links and analytics (v0.26)
#
# Every page's footer shows the release, a link to the source code and the
# third-party licenses. SOURCE_URL: AGPL-3.0 section 13 - a MODIFIED
# install must point it at its own deployed source; empty = the upstream
# repository. PRIVACY_URL, IMPRINT_URL and WHISTLEBLOWING_URL add your
# legal links (http or https, empty = not shown), reachable before sign-in.
# Plausible analytics load only with both PLAUSIBLE_SCRIPT_URL (https) and
# PLAUSIBLE_DOMAIN; without them no page loads an analytics script.
# ----------------------------------------------------------------------
SOURCE_URL=
PRIVACY_URL=
IMPRINT_URL=
WHISTLEBLOWING_URL=
PLAUSIBLE_SCRIPT_URL=
PLAUSIBLE_DOMAIN=

# ----------------------------------------------------------------------
# REQUIRED SECRETS
#
# Every value in this block must be filled in: `docker compose` refuses to
# start while one is empty, and the cms refuses to boot in production while
# one still holds a template placeholder (change-me, toBeModified, <secret>).
# Generate each value separately.
# ----------------------------------------------------------------------

# Postgres password — openssl rand -base64 24
# Fixed on the first `up`: an existing Postgres volume keeps its password,
# so a later change needs ALTER ROLE ... PASSWORD as well.
DATABASE_NAME=sinnlos
DATABASE_USERNAME=sinnlos
DATABASE_PASSWORD=

# Strapi secrets — openssl rand -base64 32 each
# APP_KEYS takes two comma-separated values: <key1>,<key2>
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
# Signs the users' Strapi JWTs (7 days, not revocable one by one). Rotating
# it signs everyone out once; do so whenever a JWT may have leaked — e.g.
# once when deploying D-SESSION-01, before which any signed-in user could
# read their own JWT from /api/auth/session. infra/deploy.sh enforces that
# rotation while the running web predates D-SESSION-01 (first deploy, or
# a roll-forward after a web rollback to such an image).
JWT_SECRET=
ENCRYPTION_KEY=

# Auth.js session secret (web) — openssl rand -base64 32
AUTH_SECRET=

# Shared cms <-> web secret for the internal live-event ingest
# (/api/live/emit — its only use since the Strapi fetch cache and its
# revalidation webhook were removed, D-DC01) — openssl rand -hex 32
REVALIDATE_SECRET=

# Shared cms <-> web internal secret: the web's session-gated /uploads
# proxy and its password-link pages (/forgot-password, /set-password; v0.27)
# present it to the cms. Without it every /uploads request answers 404 in
# production and no password link can be requested or used —
# openssl rand -hex 32
INTERNAL_UPLOAD_TOKEN=

# ----------------------------------------------------------------------
# Localisation
#
# DEFAULT_LOCALE sets the UI language for all users who haven't
# explicitly chosen one. Supported: en, de; unset or invalid = en.
# The language switch stores a user's choice on the profile too, so the
# e-mail digests use it; DIGEST_DEFAULT_LOCALE (en or de, unset or
# invalid = en) is the digest language of a user without a stored one,
# which is every user who never used the switch.
# ----------------------------------------------------------------------
DEFAULT_LOCALE=en
DIGEST_DEFAULT_LOCALE=en

# ----------------------------------------------------------------------
# Local sign-in (e-mail + password against Strapi)
#
# Always on while neither ENTRA_ENABLED nor OIDC_ENABLED is 1 (the
# default). With an identity provider on, AUTH_LOCAL_ENABLED=1 keeps it next
# to it (break-glass); the cms enforces the same rule.
# Accounts: admins invite people at /manage/users (an e-mail with a
# set-password link; needs SMTP below). Self-registration is gone (v0.27).
# ----------------------------------------------------------------------
AUTH_LOCAL_ENABLED=0
# The roles whose password sign-ins need a second factor (TOTP, v0.27): a
# comma list of role types. Unset or empty = admin_role,editor; `none` =
# nobody; an unknown role name refuses the cms boot. Those accounts enroll
# an authenticator app at their next sign-in (docs/INSTALL.md).
MFA_REQUIRED_ROLES=
# Modules and features to switch off (v0.28), a comma list; empty = all on.
# Modules: events, training, marketplace, kudos, celebrations, polls,
# duty-plans, kpis. Features: read-confirmations, training-reports,
# search-logging (training off also switches training-reports off). The
# data of an off module stays; an unknown name refuses the cms boot and
# the web start. cms and web read the same value.
FEATURES_OFF=
# SEED_DEMO_DATA=1 populates departments, teams, users, announcements,
# events, wiki pages, kudos, polls, and documents on first boot.
# All demo users share the password "Demo-Passwort-2026!". Refused when
# NODE_ENV=production (every compose deployment).
SEED_DEMO_DATA=0

# ----------------------------------------------------------------------
# Optional: first Strapi super-admin
#
# Leave both empty to create the first admin through the /admin
# registration form. When set, the cms creates the super-admin on a fresh
# database only. It refuses (error log, no admin created) template
# placeholders (change-me..., @example.com) and passwords that fail the
# Strapi admin policy: 8+ characters with an uppercase letter, a lowercase
# letter and a digit. Remove the values once the admin exists.
# ----------------------------------------------------------------------
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=

# ----------------------------------------------------------------------
# Time zone (datetime contract, docs/DEPLOYMENT.md)
#
# APP_TIME_ZONE: the IANA zone of this deployment's business days: "today",
# classified expiry, birthdays and anniversaries, digest days, the 03:30 /
# 03:35 / 07:30 cron times, all-day events and the poll deadline. Empty
# means Europe/Berlin. Spell it as the tz database does (Europe/Berlin, not
# europe/berlin; no UTC offset like +02:00): with an unknown name or an
# offset the cms does not start and the web answers every request with an
# error (both log the reason).
# Changing it later moves those boundaries, not stored instants.
# Both app containers run in UTC and compute every business date in
# APP_TIME_ZONE. Compose sets TZ; do not add it here.
# ----------------------------------------------------------------------
APP_TIME_ZONE=Europe/Berlin

# ONLY for a database written by a cms release before the datetime contract
# (every instance deployed before this release). The first boot of the new
# cms repairs the stored times once and converts them to timestamptz; with
# data present and DATETIME_LEGACY_ZONE unset it refuses to start (and
# infra/deploy.sh refuses to deploy). A fresh install leaves both empty.
#   DATETIME_LEGACY_ZONE: the zone the old cms container ran in, as an IANA
#     name (Europe/Berlin for every compose deployment since 2026-08-15;
#     a UTC offset is refused).
#   DATETIME_LEGACY_UTC_UNTIL: only if that cms ran in UTC first: the
#     switch instant, ISO-8601 with offset. Leave empty if it always ran in
#     DATETIME_LEGACY_ZONE.
# Keep both set afterwards: a pre-repair dump restored later needs them, and
# rolling back to a cms image from before the datetime contract runs it in
# DATETIME_LEGACY_ZONE (infra/docker-compose.cms-legacy-tz.yml). Runbook:
# docs/DEPLOYMENT.md "Upgrading an existing instance" and "Rolling back
# this release".
DATETIME_LEGACY_ZONE=
DATETIME_LEGACY_UTC_UNTIL=

# ----------------------------------------------------------------------
# Optional: live updates (SSE)
#
# 1 = kill switch: the cms stops emitting pings and the web falls back to
# polling. Compose passes the same value to cms and web.
# ----------------------------------------------------------------------
LIVE_EVENTS_DISABLED=0

# ----------------------------------------------------------------------
# Optional: cms background work
#
# CRON_ENABLED: the cms's scheduled jobs (the scheduled publisher every
# minute, which publishes and unpublishes the drafts whose publishAt or
# unpublishAt has come; 03:30 uploads janitor, 03:35 search-log janitor,
# 03:40 notification janitor, 03:45 classified janitor, 03:50 audit
# janitor; 07:30 digest mailer). Unset or true (the default) runs them;
# false (also 0/no/off) switches these seven off in this cms, e.g. for a
# staging copy of production data or a second cms on the same database
# (Strapi's own metrics jobs run on; none of them mails or deletes
# anything). Off, nothing scheduled publishes; the first run after it is
# back on catches up. The cms reads it like its other on/off switches
# (apps/cms/src/cron/registry.ts).
# AUDIT_RETENTION_DAYS: days the content activity trail (audit_events)
# is kept; the 03:50 audit janitor deletes older rows. Unset = 365. Must
# be a whole number of days, at least 1 (any other value deletes nothing
# and logs an error every night).
# STRAPI_TELEMETRY_DISABLED: true (the default) sends no usage telemetry to
# Strapi, and a stop no longer waits for its lookups on a host without DNS.
# ----------------------------------------------------------------------
CRON_ENABLED=true
# AUDIT_RETENTION_DAYS=365
STRAPI_TELEMETRY_DISABLED=true

# ----------------------------------------------------------------------
# Optional: e-mail digests
#
# Without SMTP_HOST/SMTP_USER/SMTP_PASS the 07:30 digest cron is a logged
# no-op ("ships dark"). Use a mailbox app password (SMTP-only), never a
# login password. Submission is STARTTLS on SMTP_PORT (default 587).
# Once SMTP is set, DIGEST_FROM is required as well: without it every run
# is skipped and infra/deploy.sh refuses to deploy (unless
# DIGESTS_DISABLED=1). Digest links point at PUBLIC_WEB_URL, which
# defaults to WEB_PUBLIC_URL. DIGESTS_DISABLED=1 switches digests off.
# ----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. Intranet <noreply@intranet.example.com>
DIGEST_FROM=
DIGEST_REPLY_TO=
DIGESTS_DISABLED=0
# PUBLIC_WEB_URL=https://intranet.example.com

# ----------------------------------------------------------------------
# Optional: Microsoft Entra ID sign-in (off by default)
#
# Nothing below is read unless ENTRA_ENABLED=1; then every value is
# validated when the cms and the web start (and by deploy.sh --check), and
# an invalid one refuses the start. Full runbook, including the staging
# dry-run: docs/DEPLOYMENT.md, "Microsoft Entra ID sign-in".
#
# Tenant setup (Entra admin center):
#  1. App registrations → New registration, "Accounts in this
#     organizational directory only" (single tenant).
#  2. Redirect URIs (Web): ${WEB_PUBLIC_URL}/api/auth/callback/microsoft-entra-id
#     and ${WEB_PUBLIC_URL}/sign-in (where sign-out returns to). No
#     front-channel logout URL (single sign-out is not implemented).
#  3. API permissions (delegated): openid, profile, email, User.Read; add
#     User.Read.All only with ENTRA_SYNC_MANAGER=1. Grant admin consent.
#  4. App roles (allowed member types Users/Groups): Intranet.Admin,
#     Intranet.Editor, Intranet.DepartmentHead, Intranet.TeamLead,
#     Intranet.Member, Intranet.Guest.
#  5. Enterprise application: Assignment required = Yes (recommended;
#     without it ENTRA_DEFAULT_ROLE applies to every tenant member), then
#     assign the app roles to users or to security groups (Entra ID P1,
#     nested groups are not expanded). Never assign public Microsoft 365
#     groups or Teams to privileged roles.
#  6. Certificates & secrets → New client secret → MS_CLIENT_SECRET.
# ----------------------------------------------------------------------
# ENTRA_ENABLED=1
# Tenant (directory) GUID; common/organizations/consumers are refused.
# MS_TENANT_ID=<directory-tenant-guid>
# Application (client) GUID.
# MS_CLIENT_ID=<application-client-guid>
# MS_CLIENT_SECRET=
# Shared by cms and web, 32+ characters: openssl rand -hex 32
# ENTRA_EXCHANGE_SECRET=
# dry-run (default): log what Entra would change, never change existing
# users, create new users at most as member. on: apply roles/departments.
# ENTRA_SYNC_MODE=dry-run
# Role of tenant members without a recognised app role or group:
# member (default) | guest | deny. Unassigned B2B guests are always denied.
# ENTRA_DEFAULT_ROLE=member
# Optional, only for nested groups or tenants without P1: comma list of
# <roleType>:<groupObjectId>, at most 20 groups (checked via checkMemberGroups).
# ENTRA_GROUP_ROLES=
# 1 = set the department from Entra (case-insensitive match on a published
# department name; empty or no match clears it).
# ENTRA_SYNC_DEPARTMENT=0
# 1 = sync the manager from Entra (needs User.Read.All + admin consent).
# ENTRA_SYNC_MANAGER=0
# Lifetime of an Entra sign-in's session, <n>m|h|d up to 7d.
# ENTRA_SESSION_TTL=12h

# ----------------------------------------------------------------------
# Optional: OIDC sign-in with Keycloak, authentik or Zitadel (off by default)
#
# Nothing below is read unless OIDC_ENABLED=1; then every value is
# validated when the cms and the web start (and by deploy.sh --check), and
# an invalid one refuses the start. Never together with ENTRA_ENABLED=1.
# Recipes per identity provider: docs/DEPLOYMENT.md, "OIDC sign-in
# (Keycloak, authentik, Zitadel)". Redirect URI in the identity provider:
# ${WEB_PUBLIC_URL}/api/auth/callback/oidc. Roles come from Intranet.Admin,
# Intranet.Editor, Intranet.DepartmentHead, Intranet.TeamLead,
# Intranet.Member and Intranet.Guest in the ID token (the highest wins).
# ----------------------------------------------------------------------
# OIDC_ENABLED=1
# Exactly as the identity provider's discovery document writes it (authentik
# with the trailing slash): https only.
# OIDC_ISSUER=https://sso.example.com/realms/sinnlos
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Shared by cms and web, 32+ characters: openssl rand -hex 32
# OIDC_EXCHANGE_SECRET=
# Button label on the sign-in page (up to 40 characters).
# OIDC_DISPLAY_NAME=Single Sign-On
# Must contain openid; Zitadel's department metadata needs
# urn:zitadel:iam:user:metadata in addition.
# OIDC_SCOPE=openid profile email
# Claim with the Intranet.* roles, a dotted path (array or object keys):
# roles (Keycloak mapper), groups (authentik), urn:zitadel:iam:org:project:roles.
# OIDC_ROLES_CLAIM=roles
# Optional claim with the department name (case-insensitive match on a
# published department; empty or no match clears it). Admin-controlled only.
# OIDC_DEPARTMENT_CLAIM=
# Zitadel: the organisation id (required with a urn:zitadel: roles claim);
# users and roles of other organisations are refused.
# OIDC_ZITADEL_ORG_ID=
# Role of users without a recognised Intranet.* role: deny (default) |
# member | guest. Anything but deny lets every user of the identity provider in.
# OIDC_DEFAULT_ROLE=deny
# Lifetime of an OIDC sign-in's session, <n>m|h|d up to 7d.
# OIDC_SESSION_TTL=12h
# 1 = allow an http issuer (local development and staging only).
# OIDC_ALLOW_HTTP=0

# ----------------------------------------------------------------------
# Optional: Meilisearch search ranking (off by default)
#
# Typo-tolerant, better-ranked results for the ⌘K search (announcements,
# wiki pages, documents, events, polls). Meilisearch only ranks: the web
# reads every hit through Strapi with the user's own rights, and falls back
# to its built-in search while Meilisearch is off, down or empty. The index
# is rebuilt from the database (about a minute after changes; no backup).
# Full runbook: docs/DEPLOYMENT.md, "Meilisearch (optional search)".
#
# To switch it on:
#  1. COMPOSE_PROFILES=search and a MEILI_MASTER_KEY (openssl rand -hex 32;
#     stays in the meili container, never in cms or web), then deploy:
#     the meili container starts, search stays off.
#  2. infra/meilisearch/provision-keys.sh prints MEILISEARCH_WRITE_KEY and
#     MEILISEARCH_SEARCH_KEY: put both here.
#  3. MEILISEARCH_ENABLED=1 and deploy again. infra/deploy.sh refuses
#     MEILISEARCH_ENABLED=1 without the profile and the three keys.
# MEILISEARCH_URL defaults to the container (http://sinnlos-meili:7700).
# ----------------------------------------------------------------------
# COMPOSE_PROFILES=search
# MEILI_MASTER_KEY=
# MEILISEARCH_ENABLED=1
# MEILISEARCH_WRITE_KEY=
# MEILISEARCH_SEARCH_KEY=
# MEILISEARCH_URL=http://sinnlos-meili:7700
