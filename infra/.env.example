# ----------------------------------------------------------------------
# Public URLs (use https://... in production, behind Caddy)
#
# DOMAIN controls Caddy's TLS behaviour:
#   - real hostname           -> automatic Let's Encrypt certificate
#   - unset (localhost)       -> self-signed cert, browser warning
#   - http://localhost        -> plain HTTP (local development only)
# ----------------------------------------------------------------------
DOMAIN=intranet.example.com
WEB_PUBLIC_URL=https://intranet.example.com
CMS_PUBLIC_URL=https://intranet.example.com

# Client IPs (FX11): the cms trusts X-Forwarded-For, so its sign-in
# throttles count per client IP — users-permissions /api/auth/local and
# the admin panel's /admin/login (5 attempts per 5 minutes per e-mail and
# IP). That is only sound while the edge OVERWRITES a client-supplied
# X-Forwarded-For. Caddy does so by default. A host Traefik
# (docker-compose.traefik.yml) does so only while its entrypoint sets no
# forwardedHeaders.insecure and lists in forwardedHeaders.trustedIPs only
# proxies that overwrite (not append to) the header — otherwise anyone
# picks their own throttle bucket and /admin/login is unthrottled.

# ----------------------------------------------------------------------
# REQUIRED SECRETS
#
# Every value in this block must be filled in: `docker compose` refuses to
# start while one is empty, and the cms refuses to boot in production while
# one still holds a template placeholder (change-me, toBeModified, <secret>).
# Generate each value separately.
# ----------------------------------------------------------------------

# Postgres password — openssl rand -base64 24
# Fixed on the first `up`: an existing Postgres volume keeps its password,
# so a later change needs ALTER ROLE ... PASSWORD as well.
DATABASE_NAME=sinnlos
DATABASE_USERNAME=sinnlos
DATABASE_PASSWORD=

# Strapi secrets — openssl rand -base64 32 each
# APP_KEYS takes two comma-separated values: <key1>,<key2>
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
# Signs the users' Strapi JWTs (7 days, not revocable one by one). Rotating
# it signs everyone out once; do so whenever a JWT may have leaked — e.g.
# once when deploying D-SESSION-01, before which any signed-in user could
# read their own JWT from /api/auth/session. infra/deploy.sh enforces that
# rotation while the running web predates D-SESSION-01 (first deploy, or
# a roll-forward after a web rollback to such an image).
JWT_SECRET=
ENCRYPTION_KEY=

# Auth.js session secret (web) — openssl rand -base64 32
AUTH_SECRET=

# Shared cms <-> web secret for the internal live-event ingest
# (/api/live/emit — its only use since the Strapi fetch cache and its
# revalidation webhook were removed, D-DC01) — openssl rand -hex 32
REVALIDATE_SECRET=

# Shared cms <-> web secret for the uploaded-file bytes: the web's
# session-gated /uploads proxy presents it to the cms. Without it every
# /uploads request answers 404 in production — openssl rand -hex 32
INTERNAL_UPLOAD_TOKEN=

# ----------------------------------------------------------------------
# Localisation
#
# DEFAULT_LOCALE sets the UI language for all users who haven't
# explicitly chosen one. Supported: en, de.
# ----------------------------------------------------------------------
DEFAULT_LOCALE=en

# ----------------------------------------------------------------------
# Standalone mode (no Microsoft / Azure)
#
# AUTH_LOCAL_ENABLED=1 turns on email+password login alongside Microsoft.
# Omit both AUTH_ and MS_ vars for a pure local setup (auto-detected).
# LOCAL_REGISTRATION=1 adds a self-registration form on the sign-in page.
# ----------------------------------------------------------------------
AUTH_LOCAL_ENABLED=0
LOCAL_REGISTRATION=0
# SEED_DEMO_DATA=1 populates departments, teams, users, announcements,
# events, wiki pages, kudos, polls, and documents on first boot.
# All demo users share the password "demo1234".
SEED_DEMO_DATA=0

# ----------------------------------------------------------------------
# Optional: first Strapi super-admin
#
# Leave both empty to create the first admin through the /admin
# registration form. When set, the cms creates the super-admin on a fresh
# database only. It refuses (error log, no admin created) template
# placeholders (change-me..., @example.com) and passwords that fail the
# Strapi admin policy: 8+ characters with an uppercase letter, a lowercase
# letter and a digit. Remove the values once the admin exists.
# ----------------------------------------------------------------------
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=

# ----------------------------------------------------------------------
# Time zone (datetime contract, docs/DEPLOYMENT.md)
#
# APP_TIME_ZONE: the IANA zone of this deployment's business days: "today",
# classified expiry, birthdays and anniversaries, digest days, the 03:30 /
# 03:35 / 07:30 cron times, all-day events and the poll deadline. Empty
# means Europe/Berlin. Spell it as the tz database does (Europe/Berlin, not
# europe/berlin; no UTC offset like +02:00): with an unknown name or an
# offset the cms does not start and the web answers every request with an
# error (both log the reason).
# Changing it later moves those boundaries, not stored instants.
# The cms container runs in UTC; the web container runs in APP_TIME_ZONE
# until its own datetime port. Compose sets both; do not add TZ here.
# ----------------------------------------------------------------------
APP_TIME_ZONE=Europe/Berlin

# ONLY for a database written by a cms release before the datetime contract
# (every instance deployed before this release). The first boot of the new
# cms repairs the stored times once and converts them to timestamptz; with
# data present and DATETIME_LEGACY_ZONE unset it refuses to start (and
# infra/deploy.sh refuses to deploy). A fresh install leaves both empty.
#   DATETIME_LEGACY_ZONE: the zone the old cms container ran in, as an IANA
#     name (Europe/Berlin for every compose deployment since 2026-08-15;
#     a UTC offset is refused).
#   DATETIME_LEGACY_UTC_UNTIL: only if that cms ran in UTC first: the
#     switch instant, ISO-8601 with offset. Leave empty if it always ran in
#     DATETIME_LEGACY_ZONE.
# Keep both set afterwards: they only matter if a pre-repair dump is ever
# restored. Runbook: docs/DEPLOYMENT.md "Upgrading an existing instance".
DATETIME_LEGACY_ZONE=
DATETIME_LEGACY_UTC_UNTIL=

# ----------------------------------------------------------------------
# Optional: live updates (SSE)
#
# 1 = kill switch: the cms stops emitting pings and the web falls back to
# polling. Compose passes the same value to cms and web.
# ----------------------------------------------------------------------
LIVE_EVENTS_DISABLED=0

# ----------------------------------------------------------------------
# Optional: e-mail digests
#
# Without SMTP_HOST/SMTP_USER/SMTP_PASS the 07:30 digest cron is a logged
# no-op ("ships dark"). Use a mailbox app password (SMTP-only), never a
# login password. Submission is STARTTLS on SMTP_PORT (default 587).
# Once SMTP is set, DIGEST_FROM is required as well: without it every run
# is skipped and infra/deploy.sh refuses to deploy (unless
# DIGESTS_DISABLED=1). Digest links point at PUBLIC_WEB_URL, which
# defaults to WEB_PUBLIC_URL. DIGESTS_DISABLED=1 switches digests off.
# ----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. Intranet <noreply@intranet.example.com>
DIGEST_FROM=
DIGEST_REPLY_TO=
DIGESTS_DISABLED=0
# PUBLIC_WEB_URL=https://intranet.example.com

# ----------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) app registration
#
# 1. Portal → App registrations → New registration
# 2. Redirect URIs (Web):
#      - ${WEB_PUBLIC_URL}/api/auth/callback/microsoft-entra-id
#      - ${CMS_PUBLIC_URL}/api/connect/microsoft/callback
# 3. API permissions: openid, profile, email, User.Read, GroupMember.Read.All
# 4. Create a client secret and copy the value below
# ----------------------------------------------------------------------
MS_TENANT_ID=your-tenant-guid-or-common
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-app-client-secret
