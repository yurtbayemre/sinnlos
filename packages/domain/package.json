{
  "name": "@sinnlos/domain",
  "private": true,
  "version": "0.1.0",
  "description": "Pure domain rules shared by the Sinnlos cms and web: no runtime dependencies, no I/O",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "^9.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.18.0"
  }
}
